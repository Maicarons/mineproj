    "documents": [
      {
        "id": "voxel-tool",
        "name": "Voxel Tool",
        "tagline": "A tiny voxel editor that runs entirely in the browser",
        "summary": "A tiny voxel editor that runs entirely in the browser with zero install, built on WebGL and a custom greedy-meshing renderer for smooth 60fps edits.",
        "tags": "web experiment"
      },
      {
        "id": "pixel-pong",
        "name": "Pixel Pong",
        "tagline": "A one-file pong clone with gamepad support",
        "summary": "A one-file pong clone with gamepad support and a CRT-style filter, written in vanilla JavaScript to prove how far a single HTML file can go in 2026.",
        "tags": "web game"
      },
      {
        "id": "csv-wrangler",
        "name": "CSV Wrangler",
        "tagline": "Command-line swiss knife for messy spreadsheets",
        "summary": "A command-line swiss knife for messy spreadsheets: streaming CSV parsing, type inference, dedupe and join, all in a single static binary with no runtime dependencies.",
        "tags": "cli tool"
      },
      {
        "id": "atlas-maps",
        "name": "Atlas Maps",
        "tagline": "Offline-first map viewer for your own tiles",
        "summary": "An offline-first map viewer that serves your own tile sets from a static host, with vector labels, a mobile-friendly UI and service-worker caching for field trips.",
        "tags": "web tool"
      },
      {
        "id": "ink-scheduler",
        "name": "Ink Scheduler",
        "tagline": "Desktop timetable planner with handwriting input",
        "summary": "A desktop timetable planner with handwriting input for stylus laptops, exporting clean PDF schedules; still an alpha experiment around time-blocking heuristics.",
        "tags": "tool experiment"
      }
    ]
  }
